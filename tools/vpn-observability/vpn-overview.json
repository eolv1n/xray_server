        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vpn_observer_success * on(node,project) (time() - vpn_observer_attempt_timestamp_seconds < bool 150)",
          "legendFormat": "{{node}}",
          "instant": true
        }
