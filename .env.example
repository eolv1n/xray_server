REMNAWAVE_PANEL_DOMAIN=panel.example.com
REMNAWAVE_SUB_DOMAIN=sub.example.com
REMNAWAVE_NODE_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# 3x-ui + Angie mode.
XUI_PANEL_DOMAIN=panel.example.com
XUI_MASK_DOMAIN=site.example.com
XUI_PANEL_PORT=2053

# Runtime paths.
REMNAWAVE_UPSTREAM_REPO=https://github.com/eGamesAPI/remnawave-reverse-proxy.git
REMNAWAVE_CLONE_DIR=/usr/local/src/remnawave-reverse-proxy
REMNAWAVE_SCRIPT_LANGUAGE=ru
REMNAWAVE_INSTALL_LEGIZ_ORION=1

# Optional fallback for VPS/IPs that hit Docker Hub rate limits.
# Keep disabled for normal installs; enable only when pulls from Docker Hub fail.
REMNAWAVE_USE_IMAGE_MIRRORS=0
REMNAWAVE_BACKEND_IMAGE=ghcr.io/remnawave/backend:2
REMNAWAVE_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18.3
REMNAWAVE_VALKEY_IMAGE=ghcr.io/valkey-io/valkey:9.0.3-alpine
REMNAWAVE_NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.28
REMNAWAVE_NODE_IMAGE=
REMNAWAVE_SUBSCRIPTION_PAGE_IMAGE=

# Node-only mode.
REMNAWAVE_PANEL_IP=
REMNAWAVE_NODE_SECRET_KEY=
REMNAWAVE_NODE_SECRET_KEY_FILE=
